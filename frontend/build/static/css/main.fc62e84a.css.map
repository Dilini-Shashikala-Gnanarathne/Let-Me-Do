.container-all-sem-wrapper{
   
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-left: 350px;
  
  }
  
  .container-all-sem-result{
    box-shadow: 0 0 10px #0066ff;
    height: 750px;
    text-align: left;
    border-radius: 20px;
     width: 500px;
     color: white;
     margin: 0 auto;
     margin-top: 5vh;
     margin-bottom: 20vh;
     
  }
  
  .container-all-sem-result:hover {
      box-shadow: 0 0 10px rgba(232, 13, 24, 0.5);
    }

  
  .title-all-result{
      color: #0066ff;
      font-size: 36px;
      margin-top: 20px;
      margin-bottom: 10px;
  
  }

  
.container-Add-result{
 width: 500px;
 text-align: center;
 color: white;
 margin: 0 auto;
 margin-top: 10vh;
 font-size: 18px;
  }

  .form-group-result{
    color: rgb(138, 128, 128);
    padding-left: 50px;
    margin-top: 2px;
  }

  .semester{
    text-align: center;
    padding-top: 5vh;
  }
  .semester-p{
    color: #fff;
    padding-top: 2vh;
  }